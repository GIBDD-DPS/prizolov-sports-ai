# ============================================
# Prizolov Sports AI - Setup
# Version: 4.01 (Social Sentiment & Global AI Upgrade)
# Author: Dm.Andreyanov
# Organization: Prizolov Market / Prizolov Lab
# Target: Production deployment at prizolov.ru
# ============================================

# 🟢 Основное приложение
APP_NAME=Prizolov Sports AI
DEBUG=false
LOG_LEVEL=INFO

# 🟢 База данных и кэш
DATABASE_URL=postgresql+asyncpg://app_user:secure_pass@db:5432/sports_ai
REDIS_URL=redis://redis:6379/0

# 🟢 Мониторинг
SENTRY_DSN=

# 🟢 Внешние API (Коэффициенты и События)
API_KEYS_ODDS=your_odds_api_key_here
API_KEYS_SPORTS=your_sports_api_key_here

# 🟢 Telegram (для парсинга каналов)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNELS=channel1,channel2,channel3

# 🟢 Интервалы планировщика (в секундах)
LIVE_INTERVAL=30
PREMATCH_INTERVAL=300
ODDS_INTERVAL=120

# ============================================
# Prediction quality profiles (choose one)
# Use script:
#   bash scripts/quality_profile_presets.sh balanced
# and copy result into your real .env / secrets.
# ============================================

# --- Conservative profile (max stability) ---
# MIN_BOOKMAKERS_PER_EVENT=3
# MIN_RECOMMENDATION_PROBABILITY=0.56
# MIN_RECOMMENDATION_COEFFICIENT=1.60
# MIN_RECOMMENDATION_EDGE=0.03
# MIN_EVENT_QUALITY_SCORE=55
# MAX_BOOKMAKER_ODDS_AGE_SECONDS=480
# MAX_RECOMMENDATIONS_PER_EVENT=5
# MAX_LINES_PER_MARKET=2
# MAX_CORRELATED_LINES_PER_EVENT=1
# MAX_TOP_RECOMMENDATIONS_PER_EVENT=1
# VALUE_ONLY_PREMIUM_ENABLED=1
# VALUE_ONLY_PREMIUM_MIN_EDGE=0.08
# VALUE_ONLY_PREMIUM_MIN_BOOKMAKERS_SUPPORT=3
# BOOKMAKER_WEIGHT_DEFAULT=1.00
# BOOKMAKER_WEIGHT_OVERRIDES={"pinnacle":1.30,"betfair":1.25,"matchbook":1.20}
# SPORT_MARKET_THRESHOLD_OVERRIDES={"football":{"spreads":{"min_probability_delta":0.02,"min_edge_delta":0.01}}}
# ADAPTIVE_THRESHOLD_ENABLED=1
# ADAPTIVE_THRESHOLD_MIN_FEEDBACK=30
# ADAPTIVE_MIN_PROBABILITY_FLOOR=0.48
# ADAPTIVE_MIN_PROBABILITY_CEIL=0.74
# SELF_LEARNING_ENABLED=1
# SELF_LEARNING_MIN_FEEDBACK=10
# SELF_LEARNING_MAX_FACTOR_SHIFT=0.20
# SELF_LEARNING_DECAY_ENABLED=1
# SELF_LEARNING_DECAY_HALF_LIFE_HOURS=96
# CLV_ALERT_NEGATIVE_THRESHOLD=-0.03

# --- Balanced profile (recommended production default) ---
# MIN_BOOKMAKERS_PER_EVENT=2
# MIN_RECOMMENDATION_PROBABILITY=0.50
# MIN_RECOMMENDATION_COEFFICIENT=1.55
# MIN_RECOMMENDATION_EDGE=0.02
# MIN_EVENT_QUALITY_SCORE=46
# MAX_BOOKMAKER_ODDS_AGE_SECONDS=900
# MAX_RECOMMENDATIONS_PER_EVENT=6
# MAX_LINES_PER_MARKET=3
# MAX_CORRELATED_LINES_PER_EVENT=2
# MAX_TOP_RECOMMENDATIONS_PER_EVENT=2
# VALUE_ONLY_PREMIUM_ENABLED=1
# VALUE_ONLY_PREMIUM_MIN_EDGE=0.06
# VALUE_ONLY_PREMIUM_MIN_BOOKMAKERS_SUPPORT=2
# BOOKMAKER_WEIGHT_DEFAULT=1.00
# BOOKMAKER_WEIGHT_OVERRIDES={"pinnacle":1.25,"betfair":1.20}
# SPORT_MARKET_THRESHOLD_OVERRIDES={"football":{"spreads":{"min_probability_delta":0.01}},"basketball":{"totals":{"min_edge_delta":0.005}}}
# ADAPTIVE_THRESHOLD_ENABLED=1
# ADAPTIVE_THRESHOLD_MIN_FEEDBACK=20
# ADAPTIVE_MIN_PROBABILITY_FLOOR=0.42
# ADAPTIVE_MIN_PROBABILITY_CEIL=0.72
# SELF_LEARNING_ENABLED=1
# SELF_LEARNING_MIN_FEEDBACK=8
# SELF_LEARNING_MAX_FACTOR_SHIFT=0.25
# SELF_LEARNING_DECAY_ENABLED=1
# SELF_LEARNING_DECAY_HALF_LIFE_HOURS=168
# CLV_ALERT_NEGATIVE_THRESHOLD=-0.05

# --- Aggressive profile (max coverage) ---
# MIN_BOOKMAKERS_PER_EVENT=2
# MIN_RECOMMENDATION_PROBABILITY=0.42
# MIN_RECOMMENDATION_COEFFICIENT=1.40
# MIN_RECOMMENDATION_EDGE=0.00
# MIN_EVENT_QUALITY_SCORE=35
# MAX_BOOKMAKER_ODDS_AGE_SECONDS=1500
# MAX_RECOMMENDATIONS_PER_EVENT=8
# MAX_LINES_PER_MARKET=4
# MAX_CORRELATED_LINES_PER_EVENT=2
# MAX_TOP_RECOMMENDATIONS_PER_EVENT=3
# VALUE_ONLY_PREMIUM_ENABLED=1
# VALUE_ONLY_PREMIUM_MIN_EDGE=0.03
# VALUE_ONLY_PREMIUM_MIN_BOOKMAKERS_SUPPORT=2
# BOOKMAKER_WEIGHT_DEFAULT=1.00
# BOOKMAKER_WEIGHT_OVERRIDES={"pinnacle":1.20}
# SPORT_MARKET_THRESHOLD_OVERRIDES={"football":{"totals":{"min_probability_delta":-0.01}},"basketball":{"spreads":{"min_edge_delta":-0.005}}}
# ADAPTIVE_THRESHOLD_ENABLED=1
# ADAPTIVE_THRESHOLD_MIN_FEEDBACK=15
# ADAPTIVE_MIN_PROBABILITY_FLOOR=0.38
# ADAPTIVE_MIN_PROBABILITY_CEIL=0.68
# SELF_LEARNING_ENABLED=1
# SELF_LEARNING_MIN_FEEDBACK=6
# SELF_LEARNING_MAX_FACTOR_SHIFT=0.30
# SELF_LEARNING_DECAY_ENABLED=1
# SELF_LEARNING_DECAY_HALF_LIFE_HOURS=72
# CLV_ALERT_NEGATIVE_THRESHOLD=-0.08


# ============================================
# External donor consensus connectors (storefront)
# ============================================
EXTERNAL_DONOR_INGESTION_ENABLED=false
EXTERNAL_CONSENSUS_ENABLED=false
EXTERNAL_CONSENSUS_MIN_SOURCES=3
EXTERNAL_DONOR_ENABLE_SYNTHETIC=false
EXTERNAL_DONOR_SIGNAL_LIMIT_PER_EVENT=10
EXTERNAL_DONOR_HTTP_TIMEOUT_SECONDS=5
EXTERNAL_DONOR_HTTP_MAX_BODY_BYTES=850000
EXTERNAL_DONOR_RSS_ITEM_LIMIT=50
EXTERNAL_DONOR_TEXT_ITEM_LIMIT=60

# Optional: extend donor catalog (JSON array of objects)
# Example item: {"id":"custom-aggregator","name":"Custom Aggregator","channel":"aggregator","weight":1.1,"active":true,"url":"https://example.com"}
EXTERNAL_DONOR_CATALOG_EXTRA_JSON=[]

# Optional: JSON prediction feeds
# Example item: {"url":"https://example.com/predictions.json","donor_id":"json-provider","donor_name":"JSON Provider","weight":1.0,"channel":"json-feed","sport":"football"}
EXTERNAL_DONOR_JSON_FEEDS=[]

# Optional: RSS/Atom feeds with tips in title/description
# Example item: {"url":"https://example.com/rss.xml","donor_id":"rss-provider","donor_name":"RSS Provider","weight":0.95,"channel":"rss","sport":"football"}
EXTERNAL_DONOR_RSS_FEEDS=[]

# Optional: text/messenger export feeds (plain text or JSON messages)
# Example item: {"url":"https://example.com/channel-export.json","donor_id":"tg-channel","donor_name":"TG Channel","weight":0.9,"channel":"messenger","sport":"football"}
EXTERNAL_DONOR_TEXT_FEEDS=[]

# Ready-to-use donor set with validated public URLs:
# docs/external_donor_pack.env

# Storefront demo fixtures (Zenit/Spartak, CSKA/Dynamo templates)
STOREFRONT_DEMO_EVENTS_ENABLED=false
ALLOW_STOREFRONT_DEMO=false

# ============================================
# Real events (The Odds API)
# ============================================
REAL_EVENTS_ENABLED=true
REAL_EVENTS_CACHE_TTL_SECONDS=90
ODDSPAPI_API_KEY=
ODDSPAPI_BOOKMAKER=pinnacle
ODDSPAPI_SPORT_IDS=10,11,15
THE_ODDS_API_KEY=

# Donors + consensus (see docs/external_donor_pack.env)
EXTERNAL_DONOR_INGESTION_ENABLED=true
EXTERNAL_CONSENSUS_ENABLED=true
