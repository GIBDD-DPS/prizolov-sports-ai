# Production: real Odds API events + external donor consensus (RSS, no synthetic demo)

REAL_EVENTS_ENABLED=true
REAL_EVENTS_CACHE_TTL_SECONDS=90
REAL_EVENTS_FETCH_LIMIT=80
# ODDSPAPI_API_KEY=set_in_amvera_only
ODDSPAPI_BOOKMAKER=pinnacle
ODDSPAPI_SPORT_IDS=10

EXTERNAL_DONOR_INGESTION_ENABLED=true
EXTERNAL_CONSENSUS_ENABLED=true
EXTERNAL_CONSENSUS_MIN_SOURCES=2
EXTERNAL_DONOR_ENABLE_SYNTHETIC=false
EXTERNAL_DONOR_SIGNAL_LIMIT_PER_EVENT=12
EXTERNAL_DONOR_HTTP_TIMEOUT_SECONDS=5
EXTERNAL_DONOR_HTTP_MAX_BODY_BYTES=850000
EXTERNAL_DONOR_RSS_ITEM_LIMIT=40
EXTERNAL_DONOR_TEXT_ITEM_LIMIT=40

EXTERNAL_DONOR_CATALOG_EXTRA_JSON='[]'
EXTERNAL_DONOR_JSON_FEEDS='[]'

# Sports news RSS (team match required — no sport-only fallback)
EXTERNAL_DONOR_RSS_FEEDS='[{"url":"https://www.rotowire.com/rss/news.php?sport=SOCCER","donor_id":"rotowire-soccer","donor_name":"RotoWire Soccer","weight":0.93,"channel":"rss","sport":"football"},{"url":"https://www.rotowire.com/rss/news.php?sport=NBA","donor_id":"rotowire-nba","donor_name":"RotoWire NBA","weight":0.9,"channel":"rss","sport":"basketball"},{"url":"https://www.rotowire.com/rss/news.php?sport=NHL","donor_id":"rotowire-nhl","donor_name":"RotoWire NHL","weight":0.9,"channel":"rss","sport":"hockey"},{"url":"https://www.covers.com/rss","donor_id":"covers-rss","donor_name":"Covers Feed","weight":0.88,"channel":"rss","sport":"football"}]'

EXTERNAL_DONOR_TEXT_FEEDS='[{"url":"https://www.bettingexpert.com/tips/feed","donor_id":"bettingexpert-tips","donor_name":"BettingExpert Tips","weight":0.9,"channel":"site-text","sport":"football"}]'

# Required on Amvera for live fixtures:
# THE_ODDS_API_KEY=your_key_here
