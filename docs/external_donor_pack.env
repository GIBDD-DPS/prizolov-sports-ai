# External donors: fully disabled (no built-in catalog, no RSS/text/synthetic)
# Enable only after adding vetted structured feeds:
#   EXTERNAL_DONOR_INGESTION_ENABLED=true
#   EXTERNAL_CONSENSUS_ENABLED=true

EXTERNAL_DONOR_INGESTION_ENABLED=false
EXTERNAL_CONSENSUS_ENABLED=false
EXTERNAL_CONSENSUS_MIN_SOURCES=2
EXTERNAL_DONOR_ENABLE_SYNTHETIC=false
EXTERNAL_DONOR_SIGNAL_LIMIT_PER_EVENT=0
EXTERNAL_DONOR_HTTP_TIMEOUT_SECONDS=5
EXTERNAL_DONOR_HTTP_MAX_BODY_BYTES=850000
EXTERNAL_DONOR_RSS_ITEM_LIMIT=0
EXTERNAL_DONOR_TEXT_ITEM_LIMIT=0

EXTERNAL_DONOR_CATALOG_EXTRA_JSON='[]'
EXTERNAL_DONOR_JSON_FEEDS='[]'
EXTERNAL_DONOR_RSS_FEEDS='[]'
EXTERNAL_DONOR_TEXT_FEEDS='[]'
