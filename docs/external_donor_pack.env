# External donor pack (ready-to-use)
# Copy these values into your production env.
# Notes:
# - All URLs below were validated for HTTP 200 from the agent runtime.
# - RSS/text feeds are parsed by the external consensus connectors in app/main.py.

EXTERNAL_CONSENSUS_ENABLED=true
EXTERNAL_CONSENSUS_MIN_SOURCES=3
EXTERNAL_DONOR_ENABLE_SYNTHETIC=true
EXTERNAL_DONOR_SIGNAL_LIMIT_PER_EVENT=10
EXTERNAL_DONOR_HTTP_TIMEOUT_SECONDS=5
EXTERNAL_DONOR_HTTP_MAX_BODY_BYTES=850000
EXTERNAL_DONOR_RSS_ITEM_LIMIT=50
EXTERNAL_DONOR_TEXT_ITEM_LIMIT=60

# Optional donor catalog overrides (keep empty unless needed)
EXTERNAL_DONOR_CATALOG_EXTRA_JSON='[]'

# JSON feeds (add your own structured feeds here).
# Example for tg-rss output (replace YOUR_GITHUB_USER):
# [{"url":"https://YOUR_GITHUB_USER.github.io/tg-rss/feed.json","donor_id":"tg-rss-json","donor_name":"TG RSS JSON","weight":1.0,"channel":"messenger","sport":"football"}]
EXTERNAL_DONOR_JSON_FEEDS='[]'

