# External donor pack (production-safe, no stale promo/news feeds)
# Copy these values into your production env.
# RSS/text promo feeds were removed — they attached unrelated news to demo events.

EXTERNAL_CONSENSUS_ENABLED=false
EXTERNAL_CONSENSUS_MIN_SOURCES=2
EXTERNAL_DONOR_ENABLE_SYNTHETIC=false
EXTERNAL_DONOR_SIGNAL_LIMIT_PER_EVENT=10
EXTERNAL_DONOR_HTTP_TIMEOUT_SECONDS=5
EXTERNAL_DONOR_HTTP_MAX_BODY_BYTES=850000
EXTERNAL_DONOR_RSS_ITEM_LIMIT=50
EXTERNAL_DONOR_TEXT_ITEM_LIMIT=50

EXTERNAL_DONOR_CATALOG_EXTRA_JSON='[]'
EXTERNAL_DONOR_JSON_FEEDS='[]'
EXTERNAL_DONOR_RSS_FEEDS='[]'
EXTERNAL_DONOR_TEXT_FEEDS='[]'

# Add only structured JSON feeds with explicit home/away + line fields, e.g.:
# EXTERNAL_DONOR_JSON_FEEDS='[{"url":"https://example.com/predictions.json","donor_id":"my-json","donor_name":"My JSON","weight":1.0,"channel":"json-feed","sport":"football"}]'
